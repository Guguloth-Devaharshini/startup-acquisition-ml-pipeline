def load_model():
    global model
    global model_metadata

    try:
        if not os.path.exists(MODEL_PATH):
            print(f"Model file not found: {MODEL_PATH}")
            return False

        model = joblib.load(MODEL_PATH)

        # Get feature names directly from trained model
        feature_names = list(model.feature_names_in_)

        # Build metadata for frontend
        model_metadata = {
            "feature_schema": {
                "feature_names": feature_names
            },
            "model_info": {
                "model_name": "Random Forest - Balanced Classes",
                "n_features": len(feature_names),
                "n_classes": len(model.classes_),
                "classes": [int(x) for x in model.classes_],
                "class_labels": {
                    str(int(cls)): CLASS_LABELS.get(
                        int(cls),
                        f"Class {int(cls)}"
                    )
                    for cls in model.classes_
                }
            }
        }

        print("=" * 60)
        print("MODEL LOADED SUCCESSFULLY")
        print("=" * 60)
        print("Model:", MODEL_PATH)
        print("Features:", len(feature_names))
        print("Classes:", len(model.classes_))

        return True

    except Exception as e:
        print(f"Error loading model: {e}")
        return False